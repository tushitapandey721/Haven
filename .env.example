# ==============================================================================
# SENTINEL AI Safety & Reflective Platform - Environment Configuration
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Ports
PORT=5000
WEB_PORT=3000

# PostgreSQL Database Connection
# In Docker Compose, the host is 'postgres'.
# For local standalone PostgreSQL, use 'localhost'.
DATABASE_URL=postgresql://sentinel:sentinel_secret@localhost:5432/sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinel

# ==============================================================================
# NVIDIA Nemotron / NIM Configuration
# ==============================================================================

NVIDIA_API_KEY= "Your API key"
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

LLM_PROVIDER=nvidia

# ==============================================================================
# Frontend & CORS Configuration
# ==============================================================================

BASE_PATH=/
API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Logging Level (debug | info | warn | error)
# ==============================================================================

LOG_LEVEL=info
